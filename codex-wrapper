#!/usr/bin/env bash

set -euo pipefail

real_home="${HOME}"
snap_home="${real_home}/snap/codex/current"
snap_config_dir="${snap_home}/.codex"
snap_xdg_config_dir="${snap_home}/.config"
real_config="${real_home}/.codex/config.toml"
snap_config="${snap_config_dir}/config.toml"

mkdir -p "${snap_config_dir}" "${snap_xdg_config_dir}"

if [[ -r "${real_config}" ]]; then
  cp "${real_config}" "${snap_config}"
  chmod 600 "${snap_config}"
fi

export HOME="${snap_home}"
export XDG_CONFIG_HOME="${snap_xdg_config_dir}"
export CODEX_HOME="${snap_home}"

exec /snap/bin/codex "$@"
