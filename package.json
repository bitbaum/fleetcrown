{
  "name": "fleetcrown",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "npx tsx scripts/generate-bash-state-vocab.ts && npm run build:widget",
    "build:widget": "esbuild widget/main.ts --bundle --minify --format=iife --outfile=public/widget.js --log-level=warning",
    "build": "next build",
    "postbuild": "bash scripts/record-build-ref.sh && bash scripts/deploy-local.sh",
    "start": "next start",
    "install-app": "bash scripts/install-fleetcrown-app.sh",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "check:schema": "npx tsx scripts/check-schema-drift.ts",
    "lint": "eslint src/ home/",
    "check:design": "bash scripts/check-design-system.sh",
    "check:desktop": "bash scripts/check-desktop.sh",
    "verify": "tsc --noEmit && npm run lint && npm run check:design && npm run check:desktop && npm run test:unit && npm run test:home && npm run test:deploy-ref-gate && npm run test:not-behind-gate && npm run test:ops",
    "smoke": "bash scripts/smoke.sh",
    "test:home": "bash scripts/test-home.sh",
    "test:ops": "bash scripts/hetzner/test-host-alerts.sh && bash scripts/hetzner/test-disk-gc.sh",
    "test:executor": "npx tsx scripts/test/executor.ts",
    "test:sandbox-executor": "npx tsx scripts/test/sandbox-executor.ts",
    "test:control-presenter": "npx tsx scripts/test/control-presenter.ts",
    "test:agent-resolution": "npx tsx scripts/test/agent-resolution.ts",
    "test:auto-reroute": "npx tsx scripts/test/auto-reroute.ts",
    "test:dod-gate": "npx tsx scripts/test/dod-gate.ts",
    "test:project-session": "npx tsx scripts/test/project-session.ts",
    "test:autopilot-defaults": "npx tsx scripts/test/autopilot-defaults.ts",
    "test:fleet-kick": "npx tsx scripts/test/fleet-kick.ts",
    "test:push-notifications": "npx tsx scripts/test/push-notifications.ts",
    "test:onboarding": "npx tsx scripts/test/onboarding.ts",
    "test:onboarding-heal": "npx tsx scripts/test/onboarding-heal.ts",
    "test:db-url": "npx tsx scripts/test/db-url.ts",
    "test:brand-sync": "npx tsx scripts/test/brand-sync.ts",
    "test:orchestration-summary": "npx tsx scripts/test/orchestration-summary.ts",
    "test:dispatch-gates": "npx tsx scripts/test/dispatch-gates.ts",
    "test:notify-close": "npx tsx scripts/test/notify-close.ts",
    "test:fact-budget": "npx tsx scripts/test/fact-budget.ts",
    "test:deploy-ref-gate": "bash scripts/test/deploy-ref-gate.sh",
    "test:not-behind-gate": "bash scripts/test/not-behind-gate.sh",
    "test:approval-cues": "npx tsx scripts/test/approval-cues.ts",
    "test:groq-error": "npx tsx scripts/test/groq-error.ts",
    "test:chat-chain": "npx tsx scripts/test/chat-chain.ts",
    "test:answering-prompt": "npx tsx scripts/test/answering-prompt.ts",
    "test:prompt-history": "npx tsx scripts/test/prompt-history.ts",
    "test:desktop-command-validator": "npx tsx scripts/test/desktop-command-validator.ts",
    "test:tab-match": "npx tsx scripts/test/tab-match.ts",
    "test:agent-comms": "npx tsx scripts/test/agent-comms.ts",
    "test:unit": "npx tsx scripts/test-unit.ts",
    "test:ai-forms": "tsx scripts/verify-ai-forms.ts",
    "test:activity-ssot": "node scripts/activity-ssot-check.mjs",
    "dogfood:loki": "node scripts/loki-dogfood.mjs",
    "dogfood:loki:ci": "FLEETCROWN_SESSION_TOKEN=$(npx tsx scripts/test/print-session-token.ts) HEADLESS=1 node scripts/loki-dogfood.mjs",
    "dogfood:ui-flows:ci": "FLEETCROWN_SESSION_TOKEN=$(npx tsx scripts/test/print-session-token.ts) HEADLESS=1 node scripts/ui-flow-dogfood.mjs",
    "dogfood:machine:ci": "FLEETCROWN_SESSION_TOKEN=$(npx tsx scripts/test/print-session-token.ts) HEADLESS=1 node scripts/machine-dogfood.mjs",
    "dogfood:self": "node scripts/fleetcrown-self-dogfood.mjs",
    "test:dispatch-status": "npx tsx scripts/test/dispatch-status.ts",
    "test:fleet-context": "npx tsx scripts/test/fleet-context.ts",
    "test:execution-access": "npx tsx scripts/test/execution-access.ts",
    "test:workspace-access": "npx tsx scripts/test/workspace-access.ts",
    "test:authenticated-smoke": "npx tsx scripts/test/authenticated-smoke.ts",
    "test:pre-push-prod-dogfood": "bash scripts/test/pre-push-prod-dogfood.sh",
    "test:loop-ssot": "npx tsx scripts/test/loop-ssot.ts",
    "test:auth-a11y": "npx tsx scripts/test/auth-a11y.ts",
    "test:loki-prefetch": "npx tsx scripts/test/loki-prefetch.ts",
    "test:digest": "npx tsx scripts/test/digest.ts",
    "test:auth": "npx tsx scripts/test/auth.ts",
    "test:orangecat-integration": "npx tsx scripts/test/orangecat-integration.ts",
    "test:orangecat-entitlement-e2e": "npx tsx scripts/test/orangecat-entitlement-e2e.ts",
    "generate:brand": "npx tsx scripts/generate-brand.mjs",
    "generate:agent-prompts": "npx tsx scripts/generate-agent-prompts.ts",
    "ingest:history": "npx tsx scripts/ingest-claude-code-history.ts",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:build": "cd desktop && npm run build",
    "desktop:preview": "cd desktop && npm run preview",
    "db:dump": "bash scripts/db/dump.sh",
    "db:restore": "bash scripts/db/restore.sh",
    "db:apply-box": "bash scripts/db/apply-box.sh",
    "deploy": "bash scripts/deploy-hetzner.sh",
    "deploy:status": "bash scripts/deploy-status.sh",
    "doctor": "bash scripts/doctor.sh",
    "git:prune": "bash scripts/git/prune-merged.sh",
    "ship": "git push origin main",
    "prepare": "husky",
    "sync:agent-core": "tsx scripts/sync-agent-core.ts",
    "probe:models": "tsx scripts/probe-models.ts",
    "audit:responsive": "node scripts/test/responsive-audit.mjs",
    "audit:mobile": "node scripts/test/mobile-interaction-audit.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fleet/ai-forms": "github:maonakamoto/ai-forms#v0.1.0",
    "@noble/hashes": "^2.3.0",
    "@noble/secp256k1": "^3.1.0",
    "@orangecat/sdk": "file:vendor/orangecat-sdk-0.2.0.tgz",
    "@sentry/nextjs": "^10.70.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bs58check": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "shadcn": "^4.17.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  }
}
