{
  "name": "fleetcrown",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "bash scripts/deploy-local.sh",
    "start": "next start",
    "install-app": "bash scripts/install-fleetcrown-app.sh",
    "migrate": "drizzle-kit push",
    "lint": "eslint src/ home/",
    "check:design": "bash scripts/check-design-system.sh",
    "smoke": "bash scripts/smoke.sh",
    "test:home": "bash scripts/test-home.sh",
    "test:control-presenter": "npx tsx scripts/test/control-presenter.ts",
    "test:autopilot-defaults": "npx tsx scripts/test/autopilot-defaults.ts",
    "test:push-notifications": "npx tsx scripts/test/push-notifications.ts",
    "test:onboarding": "npx tsx scripts/test/onboarding.ts",
    "test:onboarding-heal": "npx tsx scripts/test/onboarding-heal.ts",
    "test:db-url": "npx tsx scripts/test/db-url.ts",
    "test:orchestration-summary": "npx tsx scripts/test/orchestration-summary.ts",
    "test:dispatch-gates": "npx tsx scripts/test/dispatch-gates.ts",
    "generate:agent-prompts": "npx tsx scripts/generate-agent-prompts.ts",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:build": "cd desktop && npm run build",
    "desktop:preview": "cd desktop && npm run preview",
    "db:dump": "bash scripts/db/dump.sh",
    "db:restore": "bash scripts/db/restore.sh",
    "db:oracle-bootstrap": "bash scripts/db/oracle-bootstrap.sh",
    "db:oracle-cutover": "bash scripts/db/oracle-cutover.sh",
    "db:oracle-await": "bash scripts/db/oracle-await-cutover.sh",
    "wait:vercel": "bash scripts/wait-for-vercel.sh",
    "ship": "git push origin main && bash scripts/wait-for-vercel.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@orangecat/sdk": "file:vendor/orangecat-sdk-0.2.0.tgz",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.15.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "shadcn": "^4.1.2",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  }
}
