# Vercel uploads everything NOT excluded here when using `vercel --prod`
# from CLI. .gitignore is only partially honored, so this is the
# authoritative list of "things Vercel doesn't need to build the web app."

# Desktop app — entirely separate runtime, not built or served by Vercel.
# Leading slash anchors the pattern to repo root so it doesn't also exclude
# src/components/desktop/ (the web-side IPC bridge for the desktop shell).
/desktop/

# Local-only toolchains and vendor dirs
.local-toolchain/
.python-vendor/

# Build artifacts (also gitignored but listed here so vercel CLI honors)
.next/
node_modules/
*.tsbuildinfo

# Local backups + dev caches
backups/
.claude/
.playwright-mcp/

# Local env / vercel link state
.env*
.vercel/

# Git internals
.git/
