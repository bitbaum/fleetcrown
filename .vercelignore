# Vercel CLI uploads the working directory and respects .vercelignore.
# .gitignore is NOT respected during `vercel deploy` from a local dir,
# so files like .env.production.local — which contain LOCAL-DEV-ONLY
# overrides of production env vars — would otherwise bake the wrong
# DATABASE_URL into the deployed bundle. We surfaced this 2026-06-04
# when a Hetzner-targeted deploy was silently hitting Neon at runtime.
#
# IMPORTANT: patterns without leading `/` match anywhere in the tree.
# Use `/dirname` to anchor to repo root and avoid masking
# src/components/<dirname>/ source code with the same name.

# ── Local-only env files (would override platform env at runtime) ────
.env.local
.env.development.local
.env.production.local
.env.hetzner.local
.env.test.local

# ── Heavy root-level subprojects (NOT to be confused with same-named
#    directories under src/) ─────────────────────────────────────────
/desktop
/squashfs-root
/bridge
/home
/infra

# ── Build caches + extracted node_modules ────────────────────────────
node_modules
.next
.next-cache

# ── Local toolchains / vendored deps ─────────────────────────────────
.local-toolchain
.python-vendor

# ── Claude / dev tooling state ───────────────────────────────────────
.claude
.playwright-mcp

# ── Backup dumps + screenshots ───────────────────────────────────────
/backups
*.png
*.jpeg
*.jpg

# ── OS / editor noise ────────────────────────────────────────────────
.DS_Store
.idea
.vscode
*.swp
