{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@home/*": ["../home/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "electron.vite.config.ts"]
}
