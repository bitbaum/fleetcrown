[Unit]
Description=FleetCrown Next.js application server
After=network-online.target postgresql.service
Wants=network-online.target
# Keep retrying past the default start-limit instead of locking to "failed"
# until a manual `systemctl reset-failed` (the observed historical failure mode).
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/fleetcrown/app
EnvironmentFile=/opt/fleetcrown/app/.env
ExecStart=/opt/fleetcrown/app/launch.sh
Restart=on-failure
RestartSec=3
# Bound how long a `systemctl restart` waits for the old node to drain. Next's
# standalone server can hold keep-alive connections past a graceful SIGTERM; the
# default 90s stop made a deploy's restart block long enough that verification hit
# a still-restarting server and rolled back. KillMode=mixed SIGTERMs the main
# process then SIGKILLs the cgroup, freeing :4002 fast for the new process.
#
# Why 3 and not 15: the drain never completes, so every second here is pure
# downtime. Measured on a real deploy (2026-08-14 16:30): SIGTERM at :49, the
# server stopped answering at :51, and it then sat bound-but-refusing until
# SIGKILL at 16:31:04 — ~13s of 502s, after which the replacement logged
# "Ready in 0ms". Next closes its listener on SIGTERM but waits on keep-alive
# connections Caddy never closes, so waiting longer buys nothing and costs
# availability. 784 502s in 7 days traced to exactly this window.
TimeoutStopSec=3
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
