#!/usr/bin/env bash
# cockpit — Friendly local wrapper for Cockpit development and daily use.
# Run from the cockpit checkout or symlink to ~/bin/cockpit.
#
# IMPORTANT: When you are *inside* the cockpit source tree, the project's
# own ./node_modules/.bin/cockpit will shadow this. Always use the full
# path or a different name (see below).
#
# Recommended: symlink as "cpit" instead to avoid conflicts:
#   ln -s /home/g/dev/cockpit/scripts/cockpit ~/bin/cpit
#
# Examples:
#   cpit daemon start
#   cpit install-agent grok
#   cpit status
#   cpit pause
#   cpit resume

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

# Detect if we're being shadowed by the project's local node_modules/.bin/cockpit
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cockpit"
RESOLVED="$(command -v cockpit 2>/dev/null || echo "")"

if [[ -n "$RESOLVED" && "$RESOLVED" != "$SCRIPT_PATH" && "$RESOLVED" != "$0" ]]; then
    echo "⚠️  'cockpit' is resolving to:"
    echo "   $RESOLVED"
    echo ""
    echo "   This is almost certainly the project's own binary in"
    echo "   ./node_modules/.bin/ shadowing your ~/bin/cockpit symlink."
    echo ""
    echo "   Recommended fix (run once):"
    echo "     ln -s $SCRIPT_PATH ~/bin/cpit"
    echo ""
    echo "   Then use the non-conflicting name:"
    echo "     cpit daemon start"
    echo "     cpit install-agent grok"
    echo ""
fi

# Load env if present (the one from the installer)
if [ -f "$HOME/.config/cockpit/daemon.env" ]; then
  set -a
  source "$HOME/.config/cockpit/daemon.env"
  set +a
fi

# Force remote for production Control when you also run a local dev server
export APP_DAEMON_FORCE_REMOTE=1
export COCKPIT_DAEMON_FORCE_REMOTE=1

case "${1:-help}" in
  daemon|d)
    shift
    case "${1:-start}" in
      start)
        echo "Starting clean daemon (production, forced remote)..."
        pkill -f 'cockpit-daemon.sh' 2>/dev/null || true
        sleep 0.5
        bash scripts/cockpit-daemon.sh
        ;;
      stop)
        pkill -f 'cockpit-daemon.sh' 2>/dev/null || true
        echo "Daemon stopped."
        ;;
      restart)
        $0 daemon stop
        sleep 1
        $0 daemon start
        ;;
      *)
        echo "Usage: cockpit daemon {start|stop|restart}"
        ;;
    esac
    ;;
  install-agent|ia)
    agent="${2:-}"
    if [ -z "$agent" ]; then
      echo "Usage: cockpit install-agent <grok|claude|cursor|gemini>"
      exit 1
    fi
    echo "Triggering one-click install for $agent (will open a tab if daemon running)..."
    # This calls the production API — requires the daemon token
    if [ -z "${COCKPIT_DAEMON_TOKEN:-}" ]; then
      echo "No COCKPIT_DAEMON_TOKEN found. Source your daemon.env first."
      exit 1
    fi
    curl -s -X POST "https://cockpitapp.vercel.app/api/control/commands" \
      -H "Authorization: Bearer $COCKPIT_DAEMON_TOKEN" \
      -H "Content-Type: application/json" \
      -d "{\"type\":\"install_cli\",\"payload\":{\"agent\":\"$agent\"}}" | jq .
    echo "Check your zellij for a new 'Install $agent' tab."
    ;;
  status|s)
    echo "=== Running daemons ==="
    pgrep -f 'cockpit-daemon.sh' -a || echo "None"
    echo ""
    echo "=== Systemd user service ==="
    systemctl --user status cockpit-daemon 2>/dev/null || echo "Service not installed (run: ./scripts/install-daemon.sh)"
    echo ""
    echo "=== Recent runtime state (if any) ==="
    ls -lt /tmp/agent-current-prompt-* /tmp/agent-ready-* 2>/dev/null | head -5 || echo "No recent sentinels"
    echo "=== Your projects ==="
    cat ~/.config/agent-projects.conf 2>/dev/null | grep -E '^(Cockpit|revamp|OrangeCat)' || echo "No conf"
    ;;
  service)
    shift
    case "${1:-status}" in
      enable|install)
        echo "Installing/enabling background service..."
        ./scripts/install-daemon.sh
        ;;
      disable)
        echo "Disabling service..."
        systemctl --user disable --now cockpit-daemon 2>/dev/null || true
        ;;
      status)
        systemctl --user status cockpit-daemon 2>/dev/null || echo "Not installed"
        ;;
      *)
        echo "Usage: cockpit service {enable|disable|status}"
        ;;
    esac
    ;;
  pause)
    touch "/tmp/cockpit-pause"
    echo "Fleet paused (daemon will respect this on next cycle)."
    ;;
  resume)
    rm -f "/tmp/cockpit-pause"
    echo "Fleet resumed."
    ;;
  help|*)
    echo "cockpit — your friendly local Cockpit helper"
    echo ""
    echo "Recommended name: cpit (avoids conflicts inside the source tree)"
    echo ""
    echo "Commands:"
    echo "  cpit daemon start          # Clean start against production"
    echo "  cpit daemon stop"
    echo "  cpit install-agent grok    # Opens a tab and injects the installer"
    echo "  cpit status"
    echo "  cpit pause / resume        # Low-power mode"
    echo ""
    echo "Setup (recommended):"
    echo "  ln -s /home/g/dev/cockpit/scripts/cockpit ~/bin/cpit"
    echo ""
    echo "Then just use: cpit daemon start"
    ;;
esac