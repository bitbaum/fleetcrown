#!/usr/bin/env sh
# Run the home/ inline self-tests every push (~14s, no external deps),
# plus the dev-server smoke when the server is already up.
# To run fully authenticated: COCKPIT_SESSION_TOKEN=<token> git push

set -e

echo "→ test:home"
npm run test:home

echo "→ test:autopilot-defaults"
npm run test:autopilot-defaults

echo "→ test:digest"
npm run test:digest

echo "→ test:auth"
npm run test:auth

echo "→ test:prompt-history"
npm run test:prompt-history

echo "→ check:schema (drift guard — skips if DB unreachable)"
npm run check:schema

echo "→ test:brand-sync"
npm run test:brand-sync

BASE="${COCKPIT_URL:-http://localhost:3000}"

if ! curl -sf --max-time 2 "$BASE/api/health" >/dev/null 2>&1; then
  echo "→ smoke: server not running at $BASE — skipping (start with npm run dev or install-app)"
  exit 0
fi

echo "→ smoke: server detected at $BASE"
npm run smoke
# >>> fleetcrown push-deploy >>>
# Pushing main deploys to the Hetzner box (background; see /tmp/push-deploy-fleetcrown.log)
if git symbolic-ref --short HEAD 2>/dev/null | grep -qx main; then
  # Pin the deploy to the SHA at push time. The deploy runs detached (sleep 5),
  # by which point HEAD may have moved to another branch — building the floating
  # tree then would ship the WRONG ref. --ref makes deploy-hetzner build this
  # exact commit in an isolated worktree instead.
  DEPLOY_SHA="$(git rev-parse HEAD)"
  ( sleep 5 && env -u CI -u VERCEL bash /home/g/dev/fleetcrown/scripts/deploy-hetzner.sh --ref "$DEPLOY_SHA" ) >> /tmp/push-deploy-fleetcrown.log 2>&1 & disown 2>/dev/null || true
  echo "[push-deploy] fleetcrown: deploy of ${DEPLOY_SHA:0:12} started in background → /tmp/push-deploy-fleetcrown.log"
fi
# <<< fleetcrown push-deploy <<<
