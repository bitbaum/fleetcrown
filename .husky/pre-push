#!/usr/bin/env sh
# Before code leaves this machine: run the SAME `npm run verify` bundle CI runs
# (tsc + lint + check:design + test:unit + test:home) — one definition of
# "verified", so a `git commit --no-verify` can't slip a red past the local gate.
# Then the deploy-safety extras: schema-drift guard, dev-server smoke (if up),
# and the prod dogfood.
# To run fully authenticated: FLEETCROWN_SESSION_TOKEN=<token> git push

set -e

# Branch deletions carry no commits to verify (git sends an all-zero local sha),
# yet the full suite used to run for ~2min on every `git push --delete`. If every
# ref in this push is a deletion, skip the checks. (Only skip when we actually
# saw refs and none had commits — an empty stdin must NOT short-circuit.)
_saw_ref=""; _has_commits=""
while read -r _lref _lsha _rref _rsha; do
  _saw_ref=1
  case "$_lsha" in *[!0]*) _has_commits=1 ;; esac
done
if [ -n "$_saw_ref" ] && [ -z "$_has_commits" ]; then
  echo "→ pre-push: branch deletion only — skipping checks"
  exit 0
fi

echo "→ verify (tsc + lint + check:design + test:unit + test:home) — same bundle as CI"
npm run verify

echo "→ check:schema (drift guard — skips if DB unreachable)"
npm run check:schema

BASE="${COCKPIT_URL:-http://localhost:3000}"

# No early exit here: the push-deploy block appended below must still run.
# (A previous `exit 0` in this branch silently disabled push-to-deploy
# whenever the local dev server was down.)
if ! curl -sf --max-time 2 "$BASE/api/health" >/dev/null 2>&1; then
  echo "→ smoke: server not running at $BASE — skipping (start with npm run dev or install-app)"
else
  echo "→ smoke: server detected at $BASE"
  npm run smoke
fi

echo "→ test:pre-push-prod-dogfood"
npm run test:pre-push-prod-dogfood

