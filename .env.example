# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://cockpit:changeme@localhost:5432/cockpit

# Random secret for signing sessions — generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Authentication ───────────────────────────────────────────────────────────
# Local password (quick dev) — leave empty to use the /setup wizard on first run
LOCAL_AUTH_PASSWORD=

# GitHub OAuth (optional — get at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Timezone for cron jobs and schedule display (e.g. America/New_York)
COCKPIT_DEFAULT_TIMEZONE=Europe/Zurich

# Docker only — Postgres password (must match DATABASE_URL above)
POSTGRES_PASSWORD=changeme

# ── Daemon ⇄ Cloud bridge ────────────────────────────────────────────────────
# When the local daemon talks to a remote Cockpit (e.g. cockpitapp.vercel.app)
# it authenticates with a bearer token. Two paths exist:
#
#   1. Mint a per-user ck_* token from /settings (preferred, multi-tenant safe).
#   2. Use COCKPIT_DAEMON_TOKEN as a shared bearer — single-tenant only.
#
# To enable path (2), set BOTH of these on the *server* (Vercel / wherever
# Cockpit is hosted). The flag is required because the token maps to the
# "default" user and must not be on by accident in multi-tenant deployments.
COCKPIT_DAEMON_TOKEN=
COCKPIT_ALLOW_LEGACY_DAEMON_TOKEN=
