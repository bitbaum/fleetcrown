# Cockpit — Environment Variables
# Copy to .env.local and fill in values

# PostgreSQL connection (required)
DATABASE_URL=postgresql://cockpit:your_password@localhost:5432/cockpit

# For Vercel/cloud deployment: use a cloud DB (Neon, Supabase, etc.)
# DATABASE_URL=postgresql://user:pass@your-cloud-db.neon.tech/cockpit
