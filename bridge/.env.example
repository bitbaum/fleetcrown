# FleetCrown event bridge — config
#
# Required: connection string to the same Postgres the cloud API uses.
# The bridge's LISTEN connection must point at the database that fires
# the fc:state NOTIFY triggers (see drizzle/0022_notify_triggers.sql).
DATABASE_URL=postgresql://fleetcrown:CHANGE_ME@localhost:5432/fleetcrown?sslmode=require

# Port to listen on. Default 4001. Vercel/web clients reach this through
# whatever public URL you put in front (typically a reverse proxy on the
# same Oracle/Hetzner box terminating TLS at 443 → forwards to 4001).
PORT=4001
